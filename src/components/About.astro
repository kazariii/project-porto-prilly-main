---
import { site, aboutSkills } from "../data/portfolio";
import Lily from "./Lily.astro";
---

<section class="section" id="about" aria-labelledby="about-title">
  <div class="wrap">
    <div class="about">
      <figure class="portrait" data-reveal>
        <Lily class="deco deco--portrait" />
        <Lily class="deco deco--portrait-sm" />
        <div class="portrait__frame">
          <img
            class="portrait__img"
            src="/images/about-prilly.jpeg"
            alt={`Portrait of ${site.name}`}
            width="327"
            height="580"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption class="portrait__cap">
          <span>{site.name} — {site.role}</span>
        </figcaption>
      </figure>

      <div class="about__body" data-reveal style="--d: 100ms">
        <h2 class="about__title" id="about-title">
          <span class="heading-index" aria-hidden="true">01</span>
          <span class="heading-rule" aria-hidden="true"></span>
          <span>About</span>
        <Lily class="lily--inline" />
        </h2>

        {site.bio.map((paragraph) => <p class="about__text">{paragraph}</p>)}

        <blockquote class="about__quote">&ldquo;{site.quote}&rdquo;</blockquote>

        <ul class="about__meta">
          {
            site.meta.map((item) => (
              <li>
                <span class="meta__label">{item.label}</span>
                <span class="meta__value">{item.value}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div class="about-skills" data-reveal>
      {aboutSkills.map((group) => (
        <div class="about-skills__group">
          <h3>{group.title}</h3>
          <ul>
            {group.items.map((skill) => <li>{skill}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .about-skills {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: 28px clamp(28px, 5vw, 76px);
    margin-top: clamp(32px, 4vw, 48px);
    padding-top: 26px;
    border-top: 1px solid var(--line);
  }

  .about-skills h3 {
    margin-bottom: 16px;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .about-skills ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .about-skills li {
    max-width: 100%;
    padding: 5px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    color: var(--ink-soft);
    font-size: 13px;
    line-height: 1.5;
  }

  @media (max-width: 600px) {
    .about-skills {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
