---
import { site } from "../data/portfolio";
import Lily from "./Lily.astro";
import CVButton from "./CVButton.astro";
---

<section class="hero" id="top">
  <Lily class="deco deco--hero-big" />
  <Lily class="deco deco--hero-small" />
  <Lily class="deco deco--hero-tiny" />
  <Lily class="deco deco--hero-tiny2" />
  <div class="wrap hero__inner">
    <div class="hero__text">
      <p class="hero__eyebrow">{site.role} &middot; {site.location}</p>

      <h1 class="hero__name">
        <span>{site.firstName}</span>
        <span class="accent">{site.lastName}</span>
      </h1>

      <p class="hero__tagline">{site.tagline}</p>

      <div class="hero__actions">
        <span class="hero__status">
          <span class="dot" aria-hidden="true"></span>
          {site.availability}
        </span>

        <div class="hero__links">
          <CVButton />
          <a class="hero__cta" href="#contact">
            Let&rsquo;s talk <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>

    <figure class="hero__photo">
      <img
        src="/images/hero-about.webp"
        alt={`Portrait of ${site.name}`}
        width="829"
        height="1370"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </div>
</section>
