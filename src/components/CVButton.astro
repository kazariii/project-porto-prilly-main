---
import { site } from "../data/portfolio";
---

<a
  class="cv-button"
  href={site.cv}
  target="_blank"
  rel="noopener noreferrer"
  data-cv-preview
  aria-haspopup="dialog"
  aria-controls="cv-preview"
>
  <svg width="18" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" />
    <path d="M14 2v6h6M8 13h8M8 17h5" />
  </svg>
  <span>Lihat CV</span>
  <span class="cv-button__arrow" aria-hidden="true">↗</span>
</a>

<style>
  .cv-button.cv-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 52px;
    padding: 10px 12px 10px 22px;
    border: 1px solid var(--pink-deep);
    border-radius: 999px;
    background: var(--pink-deep);
    color: var(--white);
    box-shadow: 0 6px 18px rgb(198 44 96 / 16%);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: background 0.25s var(--ease), transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }

  .cv-button.cv-button:hover {
    border-color: var(--pink-dark);
    background: var(--pink-dark);
    color: var(--white);
    box-shadow: 0 8px 24px rgb(198 44 96 / 24%);
    transform: translateY(-2px);
  }

  .cv-button__arrow {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid rgb(255 255 255 / 35%);
    border-radius: 50%;
    font-size: 16px;
  }
</style>
