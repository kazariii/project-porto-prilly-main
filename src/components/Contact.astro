---
import { site } from "../data/portfolio";
import Lily from "./Lily.astro";
import CVButton from "./CVButton.astro";
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <Lily class="deco deco--contact-big" tone="light" />
  <Lily class="deco deco--contact-small" tone="light" />
  <Lily class="deco deco--contact-tiny" tone="light" />
  <Lily class="deco deco--contact-tiny2" tone="light" />
  <div class="wrap contact__inner">
    <p class="contact__kicker">
      <span class="heading-index" aria-hidden="true">06</span>
      <span class="heading-rule" aria-hidden="true"></span>
      Contact
    </p>

    <h2 class="contact__title" id="contact-title">
      Let&rsquo;s work{" "}
      <em>together.</em>
    </h2>

    <a class="contact__mail" href={`mailto:${site.email}`}>
      {site.email}
      <span class="arrow" aria-hidden="true">↗</span>
    </a>

    <div class="contact__socials">
      <a
        class="social-icon"
        href={site.instagram.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Instagram ${site.instagram.handle}`}
        title={`Instagram ${site.instagram.handle}`}
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5"></rect>
          <circle cx="12" cy="12" r="4.2"></circle>
          <circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"></circle>
        </svg>
      </a>
      <a
        class="social-icon"
        href={site.linkedin.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`LinkedIn ${site.linkedin.label}`}
        title={`LinkedIn ${site.linkedin.label}`}
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11.5H3V9.75Zm6.5 0h3.83v1.57h.05c.53-1 1.84-2.07 3.79-2.07 4.05 0 4.8 2.67 4.8 6.13v5.87h-4v-5.2c0-1.24-.02-2.84-1.73-2.84-1.73 0-2 1.35-2 2.75v5.29h-4V9.75Z"></path>
        </svg>
      </a>
      {
        site.tiktok && (
          <a
            class="social-icon"
            href={site.tiktok.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`TikTok ${site.tiktok.handle}`}
            title={`TikTok ${site.tiktok.handle}`}
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
              <path d="M16.6 3h-3.2v12.4a2.7 2.7 0 1 1-2.7-2.7c.3 0 .5 0 .8.1V9.5a5.9 5.9 0 1 0 5.1 5.9V9.2a7.3 7.3 0 0 0 4.2 1.3V7.3A4.3 4.3 0 0 1 16.6 3Z"></path>
            </svg>
          </a>
        )
      }
      {
        site.phone && (
          <a
            class="social-icon"
            href={`tel:${site.phone.replace(/\s/g, "")}`}
            aria-label={`Telepon ${site.phone}`}
            title={site.phone}
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"></path>
            </svg>
          </a>
        )
      }
      <CVButton />
    </div>

    <footer class="footer">
      <span>© {site.year} {site.name}</span>
      <a href="#top">
        Back to top <span aria-hidden="true">↑</span>
      </a>
    </footer>
  </div>
</section>
